GEMINI_API_KEY=

# ADR-0023 — Public AI Endpoint Abuse Defense. Optional: comma-separated extra
# origins allowed to call /api/*, beyond the deployment's own Vercel URL
# (VERCEL_URL/VERCEL_BRANCH_URL/VERCEL_PROJECT_PRODUCTION_URL, injected
# automatically by Vercel — do not set those here). Leave unset if no custom
# domain is configured. Enforcement is skipped entirely, not failed closed,
# when no Vercel deployment env vars are present (i.e. local dev).
ALLOWED_ORIGINS=

# Analytics Platform Service (sdd/analytics/03_provider_independence.md).
# VITE_ prefix required for Vite to expose these to client code.
#
# Firestore is the Analytics Provider (source of truth, per ADR-0013) — set these
# three to activate it; leaving them unset activates the Noop Provider automatically.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
# Optional: Firestore collection path for events.
VITE_FIREBASE_EVENTS_COLLECTION=events

# GA4 is a separate, optional, non-portable reporting sink — never the Provider
# (see 03_provider_independence.md's GA4 carve-out). Set this in addition to the
# three above to also forward events to Firebase Analytics dashboards.
VITE_FIREBASE_MEASUREMENT_ID=

# Amplitude is a second, independent non-portable reporting sink (ADR-0028),
# unrelated to the Firebase project above — set to also forward events to
# Amplitude's dashboards. Session Replay is deliberately off (sampleRate: 0).
VITE_AMPLITUDE_API_KEY=
